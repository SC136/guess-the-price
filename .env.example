# Copy to .env.local and fill in.
# Password for the /admin dashboard.
ADMIN_PASSWORD=change-me
# 32+ random characters used to sign the admin session cookie (e.g. `openssl rand -base64 32`).
SESSION_SECRET=
# ISO 4217 code used to format every price (INR, USD, GBP, EUR...).
NEXT_PUBLIC_CURRENCY=INR
# Optional: where products.json and uploaded images live (default ./data).
# DATA_DIR=./data
