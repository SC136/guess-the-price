# Copy to .env.local and fill in. Only the first three are needed for local development.

# Password for the /admin dashboard.
ADMIN_PASSWORD=change-me
# 32+ random characters used to sign the admin session cookie (e.g. `openssl rand -base64 32`).
SESSION_SECRET=
# ISO 4217 code used to format every price (INR, USD, GBP, EUR...). Read at build time.
NEXT_PUBLIC_CURRENCY=INR

# --- Optional locally; REQUIRED on Vercel (the Storage tab fills these in for you) ---
# Hosted catalog (Upstash Redis). Vercel's integration names these KV_REST_API_URL / KV_REST_API_TOKEN;
# either naming works. Leave them unset locally to keep using the data/products.json file.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Hosted photo storage (a PUBLIC Vercel Blob store). Leave unset locally to keep photos on disk.
# BLOB_READ_WRITE_TOKEN=

# Optional: where products.json and uploaded photos live locally (default ./data).
# DATA_DIR=./data
